# Surround Gateway build: applied after sdkconfig.defaults by the project in
# this folder (CMakeLists.txt), so a plain `idf.py build flash` here builds
# the Gateway. The speakers are built in speaker/.
CONFIG_AIRPLAY_ROLE_GATEWAY=y

# No amplifier on the Gateway.
CONFIG_AIRPLAY_AMP_CONTROL=n

# Up to 8 speakers, each with a control and an audio TCP connection, next to
# RTSP, event, PTP, mDNS, realtime relay and web sockets.
CONFIG_LWIP_MAX_SOCKETS=48
CONFIG_LWIP_MAX_ACTIVE_TCP=48

# The forwarded calls (FWD ...) and relay statistics are runtime event logs:
# keep them on the Gateway.
CONFIG_AIRPLAY_LOG_RUNTIME=y

# The Gateway is watched over its USB port: make USB Serial/JTAG the primary
# console so a panic backtrace reaches `idf.py monitor` (the panic handler
# writes only to the primary console, UART0 on the speakers).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# One HomeKit AirPlay speaker representing the whole surround system.
CONFIG_AIRPLAY_HOMEKIT=y
CONFIG_ENABLE_AIRPLAY_ARTWORK=y
CONFIG_AIRPLAY_MODEL_ID="AirPlaySpeaker1,1"

# The Gateway transmits: it sends the whole stream to every speaker (up to
# 8 x the stream, at up to twice real time while their buffers fill). The
# shared defaults are sized for a receiver that transmits little (16 static
# TX buffers, TX BA window 6). Here more TX buffers (each ~1.6 KB of internal
# RAM, held for good: +26 KB) and a wider Block Ack window let more frames go
# out per A-MPDU, so the same bytes take less air time and leave the
# sender's PTP Syncs more room. 12 is the upper end of Espressif's
# throughput recommendation (9-12); the buffers are shared by every
# speaker's BA session, so a wider window would find no frames to fill it.
# Check "MEM ... internalMin" in the boot/stream log after a change.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=12

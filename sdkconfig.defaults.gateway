# Surround Gateway build: applied after sdkconfig.defaults (see README).
#   idf.py -B build_gateway -D SDKCONFIG=build_gateway/sdkconfig \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.gateway" build
CONFIG_AIRPLAY_ROLE_GATEWAY=y

# No amplifier on the Gateway.
CONFIG_AIRPLAY_AMP_CONTROL=n

# Up to 8 speakers, each with a control and (from step 3) an audio TCP
# connection, next to RTSP, event, PTP, mDNS and web sockets.
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_MAX_ACTIVE_TCP=32

# Step 1 checks the forwarded calls in the log: keep the runtime event logs.
CONFIG_AIRPLAY_LOG_RUNTIME=y

# The Gateway is watched over its USB port: make USB Serial/JTAG the primary
# console so a panic backtrace reaches `idf.py monitor` (the panic handler
# writes only to the primary console, UART0 on the speakers).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Speaker build: applied after ../sdkconfig.defaults (and its .esp32s3 file).
# The Speaker role is the Kconfig default; only the paths that are relative
# to the project folder need the folder above.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"

# Console on the USB Serial/JTAG port, as on the Gateway: `idf.py monitor`
# over the same cable shows the speaker's log, and a panic backtrace (the
# panic handler writes only to the primary console). The shared defaults put
# it on UART0 at 921600; with nothing reading the USB port the output is
# dropped instead of blocking.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Firmware from the Gateway (spk_update.c): a new image that does not reach
# the Gateway (crash at boot, no link) goes back to the previous one at the
# next restart. spk_update_confirm() marks it good on the first PING/TIME.
# Needs the bootloader of this build: flash the speaker once over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

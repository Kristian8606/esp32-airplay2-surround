+bool gw_airplay_artwork_plist(const uint8_t *plist, size_t len,
+                             const uint8_t **data, size_t *size, bool *replace) {
+  bp_doc_t doc;
+  bp_obj_t root, update, info, value;
+  if (!open_root(&doc, &root, plist, len) ||
+      !bp_dict_find(&doc, &root, "type", &value) ||
+      !key_equals(&value, "updateMRNowPlayingInfo", sizeof("updateMRNowPlayingInfo") - 1) ||
+      !bp_dict_find(&doc, &root, "params", &update) || update.kind != BP_KIND_DICT ||
+      !bp_dict_find(&doc, &update, "type", &value) ||
+      !key_equals(&value, "npi-text", sizeof("npi-text") - 1) ||
+      !bp_dict_find(&doc, &update, "params", &info) || info.kind != BP_KIND_DICT) {
+    return false;
+  }
+  *data = NULL;
+  *size = 0;
+  *replace = bp_dict_find(&doc, &update, "mergePolicy", &value) &&
+             key_equals(&value, "replace", sizeof("replace") - 1);
+  if (bp_dict_find(&doc, &info, "kMRMediaRemoteNowPlayingInfoArtworkData", &value) &&
+      value.kind == BP_KIND_DATA) {
+    *data = value.body;
+    *size = (size_t)value.count;
+  }
+  return true;
+}
